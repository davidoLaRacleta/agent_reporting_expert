# Copy to .env and adjust, or export these directly in your shell.
# All variables are optional; ppt_agent falls back to sane local defaults.

# "openai_compatible" (default; works with Ollama, LM Studio, vLLM, OpenAI
# itself, ...) or "anthropic" (hosted Claude API).
PPT_AGENT_LLM_PROVIDER=openai_compatible

# Model name/tag as understood by the target server.
# Examples: "llama3.1" (Ollama), "qwen2.5-14b-instruct" (LM Studio), "gpt-4o" (OpenAI).
PPT_AGENT_MODEL=llama3.1

# Base URL of the OpenAI-compatible chat-completions endpoint.
# Ollama:    http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1
PPT_AGENT_BASE_URL=http://localhost:11434/v1

# Most local servers accept any non-empty placeholder value.
PPT_AGENT_API_KEY=not-needed

PPT_AGENT_TEMPERATURE=0.4
PPT_AGENT_MAX_TOKENS=2048
PPT_AGENT_MAX_TOOL_ITERATIONS=8
